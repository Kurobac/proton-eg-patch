@@ -2549,7 +2549,12 @@ static NTSTATUS alsa_get_prop_value(void
         {0xb3f8fa53, 0x0004, 0x438e, {0x90, 0x03, 0x51, 0xa4, 0x6e, 0x13, 0x9b, 0xfc}}, 2
     };
 
-    if(IsEqualPropertyKey(*prop, devicepath_key))
+    static const PROPERTYKEY containerid_key = { /* DEVPKEY_Device_ContainerId */
+        {0x8c7ed206, 0x3f8a, 0x4827, {0xb3, 0xab, 0xae, 0x9e, 0x1f, 0xae, 0xfc, 0x6c}}, 2
+    };
+    BOOL want_container = IsEqualPropertyKey(*prop, containerid_key);
+
+    if (want_container || IsEqualPropertyKey(*prop, devicepath_key))
     {
         enum AudioDeviceConnectionType connection = AudioDeviceConnectionType_Unknown;
         USHORT vendor_id = 0, product_id = 0;
@@ -2560,7 +2565,7 @@ static NTSTATUS alsa_get_prop_value(void
         char buf[128];
         int len;
 
-        if(sscanf(name, "plughw:%u,%u", &card, &device)){
+        if (sscanf(name, "plughw:%u,%u", &card, &device) == 2) {
             sprintf(uevent, "/sys/class/sound/card%u/device/uevent", card);
             fuevent = fopen(uevent, "r");
         }
@@ -2600,6 +2605,26 @@ static NTSTATUS alsa_get_prop_value(void
             fclose(fuevent);
         }
 
+        if (want_container)
+        {
+            if (connection != AudioDeviceConnectionType_USB || vendor_id != 0x054c ||
+                    (product_id != 0x0ce6 && product_id != 0x0df2))
+                params->result = E_NOTIMPL;
+            else if (*params->buffer_size < sizeof(GUID))
+            {
+                *params->buffer_size = sizeof(GUID);
+                params->result = E_NOT_SUFFICIENT_BUFFER;
+            }
+            else
+            {
+                out->vt = VT_CLSID;
+                out->puuid = params->buffer;
+                *out->puuid = (GUID){0x054c, 0xed6e, 1, {0}};
+                params->result = S_OK;
+            }
+            return STATUS_SUCCESS;
+        }
+
         /* As hardly any audio devices have serial numbers, Windows instead
         appears to use a persistent random number. We emulate this here
         by instead using the last 8 hex digits of the GUID. */
